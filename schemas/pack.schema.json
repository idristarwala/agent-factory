{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/idristarwala/agent-factory/main/schemas/pack.schema.json",
  "title": "Agent Factory Domain Pack",
  "description": "Published schema for file-based domain packs (pack.yaml / pack.json).",
  "type": "object",
  "required": ["name", "worker_roles"],
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "node_types": {
      "type": "array",
      "items": {"type": "string"}
    },
    "worker_roles": {
      "type": "array",
      "items": {"type": "string"},
      "minItems": 1
    },
    "rules": {
      "type": "array",
      "items": {"$ref": "rule.schema.json"}
    },
    "tools_allowed": {
      "type": "array",
      "items": {"type": "string"}
    },
    "proposal_arguments": {
      "type": "object",
      "description": "Fixed JSON arguments keyed by allowed proposal tool name, bound from an approved pack release.",
      "propertyNames": {"pattern": "\\S"},
      "additionalProperties": {
        "type": "object",
        "propertyNames": {"pattern": "\\S"}
      }
    },
    "tools": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Alias for tools_allowed used by some starter packs"
    }
  },
  "additionalProperties": true
}
