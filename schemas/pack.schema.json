{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/idristarwala/agent-factory/schemas/pack.schema.json",
  "title": "Agent Factory Domain Pack",
  "description": "Published schema for file-based domain packs (pack.yaml / pack.json).",
  "type": "object",
  "required": ["name", "worker_roles"],
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "node_types": {
      "type": "array",
      "items": {"type": "string"}
    },
    "worker_roles": {
      "type": "array",
      "items": {"type": "string"},
      "minItems": 1
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "text"],
        "properties": {
          "id": {"type": "string"},
          "text": {"type": "string"},
          "active": {"type": "boolean", "default": true}
        }
      }
    },
    "tools_allowed": {
      "type": "array",
      "items": {"type": "string"}
    },
    "tools": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Alias for tools_allowed used by some starter packs"
    }
  },
  "additionalProperties": true
}
